{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/.tsbuild", "!prototypes", "!packages/assets/default-pack"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 2
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/core/**",
        "packages/protocol/**",
        "packages/game/src/**",
        "packages/adapters/agent-fake/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vscode": "Only the extension may import vscode (ADR 0001)."
                }
              }
            }
          }
        }
      }
    }
  ]
}
