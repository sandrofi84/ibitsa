{
  "name": "ibitsa",
  "displayName": "Quest for Ibitsa",
  "description": "Work with AI coding agents as a pixel-art RPG.",
  "version": "0.0.0",
  "publisher": "ibitsa-dev",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.120.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onWebviewPanel:ibitsa.game"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ibitsa.openGame",
        "title": "Open Game",
        "category": "Ibitsa"
      },
      {
        "command": "ibitsa.newQuest",
        "title": "New Quest",
        "category": "Ibitsa"
      },
      {
        "command": "ibitsa.setApiKey",
        "title": "Set API Key",
        "category": "Ibitsa"
      },
      {
        "command": "ibitsa.openWorktree",
        "title": "Open Worktree in New Window",
        "category": "Ibitsa"
      }
    ],
    "configuration": {
      "title": "Ibitsa",
      "properties": {
        "ibitsa.hero.budgetUsd": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "markdownDescription": "A hero's gold pouch in US dollars. When it's spent, the hero stops and asks before spending more. Leave empty for no cap."
        },
        "ibitsa.worktree.setup": {
          "type": "string",
          "default": "",
          "markdownDescription": "A command run in each new worktree before the hero starts, e.g. `pnpm install --frozen-lockfile`. Empty runs nothing."
        },
        "ibitsa.hero.settingSources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "project",
              "user",
              "local"
            ]
          },
          "default": [
            "project"
          ],
          "uniqueItems": true,
          "markdownDescription": "Which Claude Code settings hero sessions load. `project`: the repo's `CLAUDE.md`, skills and rules. Adding `user` also loads your personal `~/.claude` skills and `CLAUDE.md` **and your personal permission rules and hooks**, which can let a hero do more without asking."
        },
        "ibitsa.claudeCodePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a `claude` executable to use instead of the one bundled with the extension. Empty uses the bundled one."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test:integration": "vscode-test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "@anthropic-ai/sdk": "0.131.0",
    "@ibitsa/agent-claude-sdk": "workspace:*",
    "@ibitsa/core": "workspace:*",
    "@ibitsa/protocol": "workspace:*",
    "@ibitsa/runtime": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ibitsa/game": "workspace:*",
    "@types/mocha": "10.0.10",
    "@types/vscode": "1.120.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "mocha": "12.0.3"
  }
}
